# Kickstart Backend environment variables.
#
# Copy to .env for local development (loaded automatically by dotenv-rails):
#   cp .env.sample .env
#
# .env is gitignored; keep real secrets out of this file's production values.
# Values shown are the app's built-in defaults — uncomment to override.

# ---- Rails core ----

# development | test | production (defaults to development)
# RAILS_ENV=development

# Log verbosity: debug | info | warn | error | fatal
# RAILS_LOG_LEVEL=info

# Threads per Puma worker (also sizes the ActiveRecord pool)
# RAILS_MAX_THREADS=3

# Number of Puma worker processes; leave unset (or "auto") for single-mode
# WEB_CONCURRENCY=

# Web server port (default 3000)
# PORT=3000

# Optional: Puma PID file location
# PIDFILE=tmp/pids/server.pid

# Run the Solid Queue job supervisor inside Puma (single-server deployments)
# SOLID_QUEUE_IN_PUMA=true

# ---- Database (development/test use the local Docker Postgres) ----

# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# PRODUCTION ONLY — do NOT enable these in development: DATABASE_URL
# overrides the DB_* settings above and points at your production host.
# DATABASE_URL=postgres://kickstart:password@db.example.com:5432/kickstart_production
# KICKSTART_DATABASE_PASSWORD=password

# ---- Cache (Solid Cache — database-backed; see config/cache.yml) ----

# Seconds a feature flag read may be cached in Rails.cache (safety net for
# out-of-band DB edits; normal toggles propagate immediately via write-through).
# FLIPPER_CACHE_TTL=60

# ---- Auth / sessions ----

# HMAC secret that signs user JWTs. Defaults to Rails' secret_key_base;
# set a dedicated value in production to decouple token signing from the
# session cookie secret (enables independent rotation).
# JWT_SECRET=

# Session lifetimes in seconds (both default to 30 days)
# ADMIN_SESSION_TTL=2592000
# USER_SESSION_TTL=2592000

# ---- ActiveAdmin / Devise ----

# Production master key (deploy secret; decrypts config/credentials.yml.enc)
# PRODUCTION ONLY:
# RAILS_MASTER_KEY=

# Rails session/secret key (Docker builds precompile assets with
# SECRET_KEY_BASE_DUMMY=1; set the real one at runtime)
# PRODUCTION ONLY:
# SECRET_KEY_BASE=

# ---- Observability (see docs/OBSERVABILITY.md) ----

# OpenTelemetry tracing. Point at the local collector to export traces;
# without an endpoint, development exports nothing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kickstart
# Only set these to deliberately override the defaults ("none" disables
# export; a low sampler ratio drops traces):
# OTEL_TRACES_EXPORTER=none
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Tagged onto spans as service.version
# APP_VERSION=

# Prometheus metrics endpoint (:METRICS_PORT/metrics), HTTP Basic auth.
# Keep in sync with config/prometheus/prometheus.yml basic_auth.
# METRICS_PORT=9394
# METRICS_AUTH_USERNAME=prometheus
# METRICS_AUTH_PASSWORD=dev-metrics-password
